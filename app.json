{
  "expo": {
    "name": "마이닥터",
    "slug": "medi-card-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/mydoctor-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.medicardai.demo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "약 봉투 사진을 선택하기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "약 봉투를 촬영하기 위해 카메라 권한이 필요합니다."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "진료 내용을 음성으로 입력하기 위해 마이크 권한이 필요합니다.",
          "speechRecognitionPermission": "진료 내용을 음성으로 입력하기 위해 음성 인식 권한이 필요합니다.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B78A6",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "457e3927-7204-4af8-9e69-0ee7e8faafc9"
      }
    }
  }
}